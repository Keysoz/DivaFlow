# Copy this file to `.env` in this directory before running `make dev-cloud`.
# Never commit real values; production secrets live in the secret manager.
# Use URL-safe characters only: the password is interpolated into DATABASE_URL
# in cloud.yml, so `@`, `:` and `%` would break the connection string.
POSTGRES_PASSWORD=choose-a-local-development-password
ERPNEXT_URL=http://host.docker.internal:8080

# Cloud API auth secrets (use the secret manager in production).
ENVIRONMENT=dev
JWT_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
