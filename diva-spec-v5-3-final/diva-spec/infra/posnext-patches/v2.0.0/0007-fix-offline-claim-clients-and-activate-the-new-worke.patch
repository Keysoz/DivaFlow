Subject: [PATCH 07/11] fix(offline): claim clients and activate the new worker
 immediately

---
 POS/vite.config.js | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/POS/vite.config.js b/POS/vite.config.js
index d354194..809de98 100644
--- a/POS/vite.config.js
+++ b/POS/vite.config.js
@@ -109,6 +109,8 @@ export default defineConfig({
 			},
 			workbox: {
 				globPatterns: ["**/*.{js,css,html,ico,png,svg,woff,woff2}"],
+				clientsClaim: true,
+				skipWaiting: true,
 				maximumFileSizeToCacheInBytes: 4 * 1024 * 1024, // 3 MB
 				navigateFallback: "/assets/pos_next/pos/index.html",
 				navigateFallbackDenylist: [/^\/api/, /^\/app/],
