From 7ec0cd7575d47fda7664d65d608983335818933a Mon Sep 17 00:00:00 2001
From: Diva Patches <patches@diva.local>
Date: Tue, 27 Oct 2026 09:23:41 +0000
Subject: [PATCH 08/12] fix(offline): absolute precache URLs for the
 root-served worker

---
 POS/vite.config.js | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/POS/vite.config.js b/POS/vite.config.js
index 809de98..38b0817 100644
--- a/POS/vite.config.js
+++ b/POS/vite.config.js
@@ -109,6 +109,16 @@ export default defineConfig({
 			},
 			workbox: {
 				globPatterns: ["**/*.{js,css,html,ico,png,svg,woff,woff2}"],
+				// The worker is served from the site root (/pos-sw.js) so it can scope /pos;
+				// precache URLs must therefore be absolute, not relative to the worker.
+				manifestTransforms: [
+					(entries) => ({
+						manifest: entries.map((entry) => ({
+							...entry,
+							url: `/assets/pos_next/pos/${entry.url}`,
+						})),
+					}),
+				],
 				clientsClaim: true,
 				skipWaiting: true,
 				maximumFileSizeToCacheInBytes: 4 * 1024 * 1024, // 3 MB
-- 
2.47.3

