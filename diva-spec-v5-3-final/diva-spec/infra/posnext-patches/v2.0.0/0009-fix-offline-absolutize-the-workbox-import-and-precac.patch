From 6ff99a731c0125783f70bd00118b0a4572b15848 Mon Sep 17 00:00:00 2001
From: Diva Patches <patches@diva.local>
Date: Tue, 27 Oct 2026 10:57:23 +0000
Subject: [PATCH 09/12] fix(offline): absolutize the workbox import and
 precache injected assets

---
 POS/copy-sw.cjs    | 11 +++++++++++
 POS/package.json   |  2 +-
 POS/src/main.js    |  4 ----
 POS/vite.config.js |  4 ++--
 4 files changed, 14 insertions(+), 7 deletions(-)
 create mode 100644 POS/copy-sw.cjs

diff --git a/POS/copy-sw.cjs b/POS/copy-sw.cjs
new file mode 100644
index 0000000..9ab270b
--- /dev/null
+++ b/POS/copy-sw.cjs
@@ -0,0 +1,11 @@
+const fs = require('fs');
+
+// Copy the built service worker to the site root so it can scope /pos.
+// The worker imports its workbox runtime relatively; at the site root that would
+// resolve to /workbox-*.js (404), so rewrite the import to the assets path.
+const src = '../pos_next/public/pos/sw.js';
+const dest = '../pos_next/www/pos-sw.js';
+let sw = fs.readFileSync(src, 'utf8');
+sw = sw.replace(/(["'(])\.\/workbox-/g, '$1/assets/pos_next/pos/workbox-');
+fs.writeFileSync(dest, sw);
+console.log('copied service worker to www/pos-sw.js (workbox import absolutized)');
diff --git a/POS/package.json b/POS/package.json
index b350dd3..e5c785b 100644
--- a/POS/package.json
+++ b/POS/package.json
@@ -5,7 +5,7 @@
 	"type": "module",
 	"scripts": {
 		"dev": "vite",
-		"build": "vite build --base=/assets/pos_next/pos/ && node -e \"const fs=require('fs');fs.copyFileSync('../pos_next/public/pos/sw.js','../pos_next/www/pos-sw.js')\"",
+		"build": "vite build --base=/assets/pos_next/pos/ && node ./copy-sw.cjs",
 		"preview": "vite preview",
 		"lint": "biome check .",
 		"lint:fix": "biome check --write .",
diff --git a/POS/src/main.js b/POS/src/main.js
index b5012f4..7086b82 100644
--- a/POS/src/main.js
+++ b/POS/src/main.js
@@ -63,10 +63,6 @@ if ("serviceWorker" in navigator) {
 					for (const old of await navigator.serviceWorker.getRegistrations()) {
 						if (old.scope.endsWith("/assets/pos_next/pos/")) old.unregister();
 					}
-					// Cache the POS page now so the first visit already works offline
-					await navigator.serviceWorker.ready;
-					const shell = await caches.open("pos-page-cache");
-					if (!(await shell.match("/pos/"))) await shell.add("/pos/");
 				})
 				.catch((err) => log.error("Service Worker registration error", err));
 		},
diff --git a/POS/vite.config.js b/POS/vite.config.js
index 38b0817..dcfd723 100644
--- a/POS/vite.config.js
+++ b/POS/vite.config.js
@@ -69,7 +69,7 @@ export default defineConfig({
 		}),
 		VitePWA({
 			registerType: "autoUpdate",
-			includeAssets: ["favicon.png", "icon.svg", "icon-maskable.svg"],
+			injectRegister: false,
 			manifest: {
 				name: "POSNext",
 				short_name: "POSNext",
@@ -108,7 +108,7 @@ export default defineConfig({
 				],
 			},
 			workbox: {
-				globPatterns: ["**/*.{js,css,html,ico,png,svg,woff,woff2}"],
+				globPatterns: ["**/*.{js,css,html,ico,png,svg,woff,woff2,webmanifest}"],
 				// The worker is served from the site root (/pos-sw.js) so it can scope /pos;
 				// precache URLs must therefore be absolute, not relative to the worker.
 				manifestTransforms: [
-- 
