 		cleanup();
 		stopActivityTracking();
 		qzDisconnect();
@@ -2320,6 +2363,78 @@ async function handlePaymentCompleted(paymentData) {
 	}
 }
 
+
+function lastCartLine() {
+	const items = cartStore.invoiceItems || [];
+	return items.length ? items[items.length - 1] : null;
+}
+
+function removeLastLine() {
+	const item = lastCartLine();
+	if (item) cartStore.removeItem(item.item_code, item.uom);
+}
+
+function handleGlobalShortcuts(event) {
+	if (showShortcutsHelp.value) {
+		if (event.key === "Escape") showShortcutsHelp.value = false;
+		return;
+	}
+	if (uiStore.isAnyDialogOpen) return;
+
+	const active = document.activeElement;
+	const typing =
+		active && (active.tagName === "INPUT" || active.tagName === "TEXTAREA" || active.isContentEditable);
+	const mod = event.ctrlKey || event.metaKey;
+	let handled = true;
+
+	switch (event.key) {
+		case "F1":
+			showShortcutsHelp.value = true;
+			break;
+		case "F2":
+			document.getElementById("cart-customer-search")?.focus();
+			break;
+		case "F3":
+		case "F4":
+		case "F5":
+			invoiceCartRef.value?.openLastItemEditor?.();
+			break;
+		case "F6":
+			removeLastLine();
+			break;
+		case "F7":
+			uiStore.showDraftDialog = true;
+			break;
+		case "F8":
+			handleProceedToPayment();
+			break;
+		case "F9":
+			if (uiStore.lastInvoiceName) handlePrintInvoice({ name: uiStore.lastInvoiceName });
+			else showWarning(__("Print is available after the invoice is created"));
+			break;
+		case "F10":
+			handleClearCart();
+			break;
+		default:
+			if (mod && (event.key === "f" || event.key === "F")) {
+				document.getElementById("item-search")?.focus();
+			} else if (mod && event.key === "Delete") {
+				handleClearCart();
+			} else if (mod && (event.key === "z" || event.key === "Z") && (!typing || active?.id === "item-search")) {
+				removeLastLine();
+			} else if (mod && (event.key === "r" || event.key === "R")) {
+				uiStore.showReturnDialog = true;
+			} else {
+				handled = false;
+			}
+	}
+
+	if (handled) {
+		event.preventDefault();
+		event.stopPropagation();
+	}
+}
+
 function handleClearCart() {
 	if (cartStore.isEmpty) return;
 	uiStore.showClearCartDialog = true;
