 pos_next/hooks.py | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/pos_next/hooks.py b/pos_next/hooks.py
index 534680d..2eebea3 100644
--- a/pos_next/hooks.py
+++ b/pos_next/hooks.py
