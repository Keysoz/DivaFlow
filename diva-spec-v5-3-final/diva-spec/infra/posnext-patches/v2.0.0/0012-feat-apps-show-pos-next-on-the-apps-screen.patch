 # required_apps = []
 
 # Each item in the list will be shown as an app in the apps page
-# add_to_apps_screen = [
-# 	{
-# 		"name": "pos_next",
-# 		"logo": "/assets/pos_next/logo.png",
-# 		"title": "POS Next",
-# 		"route": "/pos_next",
-# 		"has_permission": "pos_next.api.permission.has_app_permission"
-# 	}
-# ]
+add_to_apps_screen = [
+	{
+		"name": app_name,
+		"logo": "data:image/svg+xml;base64,",
+		"title": app_title,
+		"route": "/app/posnext",
+		"has_permission": "frappe.permissions.check_app_permission",
+		"sequence_id": 4,
+	}
+]
 
