diff --git a/POS/src/composables/useEscapeToClose.js b/POS/src/composables/useEscapeToClose.js
new file mode 100644
index 0000000..eda8627
--- /dev/null
+++ b/POS/src/composables/useEscapeToClose.js
@@ -0,0 +1,49 @@
+import { onBeforeUnmount, watch } from "vue";
+
+/**
+ * Close the topmost open custom popup on Escape.
+ *
+ * Frappe UI dialogs already handle Escape themselves. The POS app also has
+ * custom full-screen modals (settings, product/promotion management, stock
+ * lookup, invoice management, edit item, partial payments) that did not.
+ * Components register their own close callback here; the stack tracks the
+ * opening order so a nested popup closes before its parent.
+ */
+const openPopups = [];
+let listenerInstalled = false;
+
+function onKeydown(event) {
+	if (event.key !== "Escape" || event.defaultPrevented) return;
+	const top = openPopups[openPopups.length - 1];
+	if (!top) return;
+	event.preventDefault();
+	event.stopImmediatePropagation();
+	top.close();
+}
+
+function ensureListener() {
+	if (listenerInstalled) return;
+	document.addEventListener("keydown", onKeydown, true);
+	listenerInstalled = true;
+}
+
+export function useEscapeToClose(isOpen, close) {
+	const entry = { close };
+	const sync = () => {
+		const index = openPopups.indexOf(entry);
+		if (index !== -1) openPopups.splice(index, 1);
+		const visible = typeof isOpen === "function" ? isOpen() : Boolean(isOpen?.value);
+		if (visible) openPopups.push(entry);
+	};
+
+	watch(
+		() => (typeof isOpen === "function" ? isOpen() : isOpen?.value),
+		sync,
+		{ immediate: true }
+	);
+	onBeforeUnmount(() => {
+		const index = openPopups.indexOf(entry);
+		if (index !== -1) openPopups.splice(index, 1);
+	});
+	ensureListener();
+}
