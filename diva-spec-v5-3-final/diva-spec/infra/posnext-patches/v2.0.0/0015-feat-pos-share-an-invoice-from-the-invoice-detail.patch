@@ -490,10 +537,17 @@ import { getInvoiceStatusColor } from "@/utils/invoice";
 import { logger } from "@/utils/logger";
 import { hydrateLocalOnlyInvoice, isLocalOnlyInvoiceName } from "@/utils/printInvoice";
 import { Button, Dialog, call } from "frappe-ui";
+import { useLocale } from "@/composables/useLocale";
+import { useToast } from "@/composables/useToast";
 import { ref, watch, nextTick, computed } from "vue";
 
 const log = logger.create("InvoiceDetailDialog");
 const { formatDate, formatTime } = useFormatters();
+const { handleError } = useToast();
+const { locale } = useLocale();
+
+// The A4 invoice format is shared with the Desk (E-18/DEC-97).
+const INVOICE_PRINT_FORMAT = "Diva Sales Invoice A4";
 
 const props = defineProps({
 	modelValue: Boolean,
@@ -514,6 +568,16 @@ const emit = defineEmits(["update:modelValue", "print-invoice"]);
 const show = ref(props.modelValue);
 const loading = ref(false);
 const invoiceData = ref(null);
+const sharingWhatsApp = ref(false);
+
+// Only a submitted, server-side invoice can be printed or shared; a local-only
+// (offline queue) receipt has no server record and no party phone.
+const canShare = computed(
+	() =>
+		Boolean(invoiceData.value?.name) &&
+		!isLocalOnlyInvoiceName(invoiceData.value.name) &&
+		Number(invoiceData.value.docstatus) === 1
+);
 
 // Computed: Check if this is a credit sale (Pay on Account - no payments, full outstanding)
 const isCreditSale = computed(() => {
@@ -621,4 +685,40 @@ function handlePrint() {
 	if (!invoiceData.value) return;
 	emit("print-invoice", invoiceData.value);
 }
+
+function printViewUrl(name, triggerPrint) {
+	const params = new URLSearchParams({
+		doctype: "Sales Invoice",
+		name,
+		format: INVOICE_PRINT_FORMAT,
+		no_letterhead: "1",
+	});
+	if (triggerPrint) params.set("trigger_print", "1");
+	return `/printview?${params.toString()}`;
+}
+
+function handleDownloadPdf() {
+	if (!canShare.value) return;
+	window.open(printViewUrl(invoiceData.value.name, true), "_blank", "noopener");
+}
+
+async function handleOpenWhatsApp() {
+	if (!canShare.value || sharingWhatsApp.value) return;
+	sharingWhatsApp.value = true;
+	try {
+		const result = await call("diva_guard.share.invoice_share", {
+			doctype: "Sales Invoice",
+			name: invoiceData.value.name,
+			language: locale.value === "en" ? "en" : "ar",
+		});
+		if (result?.wa_link) {
+			window.open(result.wa_link, "_blank", "noopener");
+		}
+	} catch (error) {
+		log.error("Failed to build the WhatsApp share link:", error);
+		handleError(error, __("Could not open WhatsApp. Check the customer's phone number."));
+	} finally {
+		sharingWhatsApp.value = false;
+	}
+}
 </script>
