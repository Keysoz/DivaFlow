index 8b4c77c..c52e8a0 100644
--- a/POS/src/components/invoices/InvoiceDetailDialog.vue
+++ b/POS/src/components/invoices/InvoiceDetailDialog.vue
@@ -461,23 +461,70 @@
 			</div>
 		</template>
 		<template #actions>
