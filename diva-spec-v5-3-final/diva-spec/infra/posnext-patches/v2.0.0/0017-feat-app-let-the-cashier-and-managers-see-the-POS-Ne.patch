From e112d4de5497f62589de4284045874256cceef27 Mon Sep 17 00:00:00 2001
From: Diva Patches <patches@diva.local>
Date: Tue, 3 Nov 2026 23:40:18 +0000
Subject: [PATCH] feat(app): let the cashier and managers see the POS Next app
 tile (E-18)

The vendor tile used frappe.permissions.check_app_permission, which only
lets System Managers see it. Check the shop roles instead so the cashier and
the managers can open POS Next from the apps screen.
---
 pos_next/hooks.py       |  2 +-
 pos_next/permissions.py | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 33 insertions(+), 1 deletion(-)
 create mode 100644 pos_next/permissions.py

diff --git a/pos_next/hooks.py b/pos_next/hooks.py
index 2eebea3..9e328a3 100644
--- a/pos_next/hooks.py
+++ b/pos_next/hooks.py
@@ -19,7 +19,7 @@ add_to_apps_screen = [
 		"logo": "data:image/svg+xml;base64,",
 		"title": app_title,
 		"route": "/app/posnext",
-		"has_permission": "frappe.permissions.check_app_permission",
+		"has_permission": "pos_next.permissions.can_use_pos_app",
 		"sequence_id": 4,
 	}
 ]
diff --git a/pos_next/permissions.py b/pos_next/permissions.py
new file mode 100644
index 0000000..14c6c6b
--- /dev/null
+++ b/pos_next/permissions.py
@@ -0,0 +1,32 @@
+"""App-screen visibility for POS Next (Diva patch 0017).
+
+The vendor tile used ``frappe.permissions.check_app_permission``, which only
+lets System Managers see it. The shop's cashier and managers need the tile, so
+this checks their roles instead.
+"""
+
+from __future__ import annotations
+
+import frappe
+
+POS_ROLES = frozenset(
+	{
+		"System Manager",
+		"Sales Manager",
+		"Sales Master Manager",
+		"Purchase Manager",
+		"Stock Manager",
+		"Accounts Manager",
+		"Accounts User",
+		"Sales User",
+		"Stock User",
+		"POSNext Cashier",
+	}
+)
+
+
+def can_use_pos_app() -> bool:
+	"""Show the POS Next tile to the cashier and the managers."""
+	if frappe.session.user == "Administrator":
+		return True
+	return bool(POS_ROLES & set(frappe.get_roles(frappe.session.user)))
